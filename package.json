{
  "name": "revdeck",
  "version": "0.3.2",
  "description": "Agent-first code review for GitLab and GitHub: local daemon, CLI, MCP server and a triage UI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "revdeck": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "examples",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "node scripts/build-server.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ui/tsconfig.json --threshold error",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:daemon": "tsx src/daemon/main.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "dev:mcp": "tsx src/mcp/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "shiki": "^4.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "code-review",
    "gitlab",
    "github",
    "pull-request",
    "merge-request",
    "mcp",
    "model-context-protocol",
    "agent",
    "cli",
    "svelte",
    "developer-tools"
  ],
  "author": "Alexander Katrov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katrov/revdeck.git"
  },
  "homepage": "https://github.com/katrov/revdeck#readme",
  "bugs": {
    "url": "https://github.com/katrov/revdeck/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
